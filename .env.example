# ==========================================================
# KONFIGURASI ENVIRONMENT GANESPIC XXV (VERCEL)
# ==========================================================

# 1. Password Admin (untuk login di admin.html dan otorisasi API)
ADMIN_PASSWORD=admininformasipublikasi

# 2. Database Vercel Postgres / Neon (Otomatis diisi oleh Vercel jika dibuat via tab Storage)
# POSTGRES_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# POSTGRES_PRISMA_URL="..."
# POSTGRES_URL_NON_POOLING="..."
# POSTGRES_USER="..."
# POSTGRES_HOST="..."
# POSTGRES_PASSWORD="..."
# POSTGRES_DATABASE="..."

# ==========================================================
# AI GENERATIF (Jembatan AI di /api/ai.js)
# ==========================================================
# AI HANYA lewat API di server. Kalau key kosong / model salah / error /
# timeout, halaman AI hanya menampilkan pesan error (tidak ada lagi
# jawaban cadangan JavaScript).
#
# ⭐ REKOMENDASI GRATIS: Groq — key gratis di https://console.groq.com/keys
#    Model gratis yang bisa dipakai: openai/gpt-oss-120b atau openai/gpt-oss-20b
#    (api/ai.js otomatis coba model cadangan gratis bila AI_MODEL ditolak)
#
# Format key menyesuaikan provider-nya (semua OpenAI-compatible):
#   Groq       → https://api.groq.com/openai/v1   model: openai/gpt-oss-120b  (GRATIS)
#   OpenAI    → https://api.openai.com/v1        model: gpt-4o-mini
#   OpenRouter → https://openrouter.ai/api/v1     model: openai/gpt-4o-mini
#   DeepSeek → https://api.deepseek.com/v1        model: deepseek-chat
#
# AI_API_KEY=gsk_xxxxxxxxxxxxxx
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
