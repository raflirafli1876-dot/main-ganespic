# ==========================================================
# KONFIGURASI ENVIRONMENT GANESPIC XXV (VERCEL)
# ==========================================================

# 1. Password Admin (untuk login di admin.html dan otorisasi API)
ADMIN_PASSWORD=admininformasipublikasi

# 2. Database Vercel Postgres / Neon (Otomatis diisi oleh Vercel jika dibuat via tab Storage)
# POSTGRES_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# POSTGRES_PRISMA_URL="..."
# POSTGRES_URL_NON_POOLING="..."
# POSTGRES_USER="..."
# POSTGRES_HOST="..."
# POSTGRES_PASSWORD="..."
# POSTGRES_DATABASE="..."

# ==========================================================
# AI GENERATIF (OPSIONAL — Jembatan AI di /api/ai.js)
# ==========================================================
# Jika diisi, AI di card "AI" pada halaman utama otomatis memakai
# LLM generatif (bisa jawab bahasa natural & pertanyaan "siapa ketua
# angkatan?", dll). Jika KOSONG, AI otomatis fallback ke mesin
# JavaScript rule-based (tetap bisa jawab ultah/event/link).
#
# ⭐ REKOMENDASI GRATIS: Groq (groq/compound-mini)
#    Key gratis di: https://console.groq.com/keys
#    Model ini di belakang layar pakai llama-3.3-70b-versatile.
#
# Format key menyesuaikan provider-nya (semua OpenAI-compatible):
#   Groq      → https://api.groq.com/openai/v1   model: groq/compound-mini  (GRATIS)
#   OpenAI    → https://api.openai.com/v1        model: gpt-4o-mini
#   OpenRouter → https://openrouter.ai/api/v1     model: openai/gpt-4o-mini
#   DeepSeek → https://api.deepseek.com/v1        model: deepseek-chat
#
# AI_API_KEY=gsk_xxxxxxxxxxxxxx
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=groq/compound-mini
