{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/ai.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/news",
      "schedule": "0 17 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/news",
      "destination": "/api/news.js"
    }
  ]
}
